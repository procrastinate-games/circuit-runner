// Cloudflare Workers config — serves the Vite build (dist/) as static assets.
// No server code: the game is a static site. Workers Builds runs
// `npm run build` then `npx wrangler deploy` on every push to main.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pg-circuit-runner",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
